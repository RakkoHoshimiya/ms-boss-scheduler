{
  "name": "gmsr-scheduler-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts-check-icons.mjs",
    "preview": "vite preview",
    "smoke": "node smoke-test.mjs",
    "check-icons": "node scripts-check-icons.mjs",
    "check:integrity": "node scripts-check-integrity.mjs",
    "verify:mobile": "node verify-mobile.mjs",
    "verify:webrtc": "node --experimental-strip-types verify-webrtc.mjs",
    "verify:audio": "node --experimental-strip-types verify-audio-gain.mjs",
    "verify:volume-ui": "node verify-volume-ui.mjs",
    "verify:myruns-sort": "node --experimental-strip-types verify-myruns-sort.mjs",
    "verify:layout-switch": "node verify-layout-switch.mjs",
    "verify:sync": "node verify-page-sync.mjs",
    "verify:notes": "node --experimental-strip-types verify-note-content.mjs && node --experimental-strip-types verify-note-drafts.mjs && node verify-note-compose.mjs && node --experimental-strip-types verify-note-images.mjs",
    "verify:auth-session": "node verify-auth-session.mjs",
    "verify:voice-lifecycle": "node verify-voice-lifecycle.mjs"
  },
  "dependencies": {
    "livekit-client": "^2.22.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "6.4.6"
  }
}
