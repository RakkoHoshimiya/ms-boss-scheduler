# ============================================================================
# GMSR BOSS 组队排班系统 —— 环境变量模板
#
# 用法：复制为 /opt/gmsr/gmsr.env，填入真实值，然后：
#   chmod 600 /opt/gmsr/gmsr.env
#   chown gmsr:gmsr /opt/gmsr/gmsr.env
#
# 标注「必填」的项不填会启动失败或行为异常；其余可省略用默认值。
# 所有 <...> 尖括号内容都是占位符，必须替换，不要原样保留。
# ============================================================================

# ---------- 数据库（必填）----------
GMSR_DB_URL=jdbc:postgresql://127.0.0.1:5432/gmsr?currentSchema=gmsr
GMSR_DB_USER=gmsr_app
GMSR_DB_PASSWORD=<DB_PASSWORD>
# schema 名，默认 gmsr。数据库账号必须有 search_path = gmsr, public，
# 否则触发器里的函数会报 relation "xxx" does not exist。
# GMSR_DB_SCHEMA=gmsr

# ---------- 登录会话存储（必填）----------
# SA-Token 的会话与 refresh token 全部存在这里。
# Redis 不可用 → 所有人立刻变成未登录状态（数据不受影响，但没人能登录）。
GMSR_REDIS_HOST=127.0.0.1
GMSR_REDIS_PORT=6379
GMSR_REDIS_PASSWORD=<REDIS_PASSWORD>
# 与其它业务隔离用的库号
GMSR_REDIS_DB=1

# ---------- 账号（必填）----------
# 首次启动自动创建的管理员账号
GMSR_ADMIN_USER=admin
GMSR_ADMIN_PASSWORD=<ADMIN_PASSWORD>
# 群友账号初始密码（也是管理员重置后的密码）。
# 不设置会退回源码里的默认值 gmsr123456，务必覆盖。
# 所有账号首次登录都会被强制改密。
GMSR_PLAYER_PASSWORD=<PLAYER_PASSWORD>

# ---------- 登录防护（可选）----------
# 同账号连续失败多少次后锁定
# GMSR_LOGIN_MAX_ATTEMPTS=8
# 同来源 IP 的阈值（放宽，避免同一网络下互相影响）
# GMSR_LOGIN_MAX_ATTEMPTS_PER_IP=30
# 锁定时长（分钟）
# GMSR_LOGIN_LOCK_MINUTES=15

# ---------- 跨域（可选）----------
# 同源部署时不需要。只有本地用 vite（5173）直连后端时才要填。
# GMSR_CORS=http://127.0.0.1:5173

# ---------- BOSS 图标自检（可选）----------
# 仅用于启动时检查图标文件是否存在，缺失只会告警，不影响启动。
# GMSR_BOSS_ICON_DIR=/var/www/gmsr/boss-icons

# ---------- 语音频道 LiveKit（可选）----------
# 不启用就保持 false，其余三项可以不填。
# 需在防火墙上放行：UDP 50000-50200、TCP 7881、UDP/TCP 3478、TCP 5349
GMSR_VOICE_ENABLED=false
# GMSR_VOICE_API_KEY=填写 livekit.yaml 里的 key
# GMSR_VOICE_API_SECRET=填写 livekit.yaml 里的 secret
# GMSR_VOICE_WS_URL=wss://your.domain.com/rtc
