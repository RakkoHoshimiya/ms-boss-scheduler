# 后端运行环境变量，部署到 /opt/gmsr/gmsr.env（权限 600，属主 gmsr）
GMSR_DB_URL=jdbc:postgresql://127.0.0.1:54233/gmsr?currentSchema=gmsr
GMSR_DB_USER=gmsr_app
GMSR_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# JWT 签名密钥（生产环境请替换为随机值，base64 或 32 位以上字符串）
GMSR_JWT_SECRET=CHANGE_ME_JWT_SECRET
# 首次启动自动创建的管理员账号
GMSR_ADMIN_USER=admin
GMSR_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# 允许跨域的来源（同源部署时其实用不到，保留以便本地 vite 调试）
GMSR_CORS=http://127.0.0.1:8080,http://<YOUR_SERVER_IP>:8080,https://<YOUR_SERVER_IP>:4433

# ===== BOSS 语音频道（LiveKit）=====
# 需放行端口：UDP 50000-50200、TCP 7881、UDP/TCP 3478、TCP 5349
GMSR_VOICE_ENABLED=true
GMSR_VOICE_API_KEY=填 livekit.yaml 里的 key
GMSR_VOICE_API_SECRET=填 livekit.yaml 里的 secret
GMSR_VOICE_WS_URL=wss://<YOUR_SERVER_IP>:4433/rtc
